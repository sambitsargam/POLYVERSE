# Environment Variables for 1inch Fusion+ Integration
# Copy this file to .env.local and fill in your values

# 1inch API Configuration
INCH_API_KEY=your_1inch_api_key_here
INCH_API_BASE_URL=https://api.1inch.dev/fusion-plus

# Demo Private Keys (TESTNET ONLY - NEVER USE IN PRODUCTION)
PRIVATE_KEY_MAKER=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef12
PRIVATE_KEY_TAKER=0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890ab

# Testnet RPC URLs
RPC_URL_POLYGON_MUMBAI=https://rpc.ankr.com/polygon_mumbai
RPC_URL_GOERLI=https://rpc.ankr.com/eth_goerli
RPC_URL_SEPOLIA=https://rpc.ankr.com/eth_sepolia
RPC_URL_CHAIN_A=https://rpc.ankr.com/polygon_mumbai
RPC_URL_CHAIN_B=https://rpc.ankr.com/eth_sepolia

# Chain IDs for testnets
CHAIN_ID_POLYGON_MUMBAI=80001
CHAIN_ID_GOERLI=5
CHAIN_ID_SEPOLIA=11155111

# Token Addresses (Testnet)
USDC_POLYGON_MUMBAI=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
USDC_SEPOLIA=0xA0b86991c31D4712114c1d3de34b4A6E0A8B6c3f2
WMATIC_MUMBAI=0x9c3C9283D3e44854697Cd22D3Faa240Cfb032889

# Demo wallet addresses (derived from private keys above)
DEMO_MAKER_ADDRESS=0x742d35Cc6634C0532925a3b8D4020D7B8B5c8D5b
DEMO_TAKER_ADDRESS=0x8ba1f109551bD432803012645Hac136c8ad49e7A

# Next.js Public Variables (accessible in browser)
NEXT_PUBLIC_ENABLE_1INCH_FUSION=true
NEXT_PUBLIC_DEFAULT_SOURCE_CHAIN=80001
NEXT_PUBLIC_DEFAULT_DEST_CHAIN=11155111

# Existing Lighthouse/Filecoin config
NEXT_PUBLIC_LIGHTHOUSE_API_KEY=d68ab55c.b942be309fdb466ab60e799ba9d79f26
LIGHTHOUSE_GATEWAY_URL=https://gateway.lighthouse.storage/ipfs/
FILECOIN_RPC=https://api.calibration.node.glif.io/rpc/v1
NETWORK=calibration
NEXT_PUBLIC_GATEWAY_URL=https://gateway.lighthouse.storage/ipfs/